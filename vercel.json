{
  "version": 2,
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "functions": {
    "api/alchemy.ts": {
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}


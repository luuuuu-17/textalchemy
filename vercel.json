{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/alchemy.ts": {
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/api/alchemy",
      "dest": "/api/alchemy"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
